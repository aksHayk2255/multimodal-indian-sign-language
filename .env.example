# Django Backend Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default is SQLite for development)
# DATABASE_URL=sqlite:///db.sqlite3

# External Translation / Speech API keys (Optional - fallback is local/free engines)
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=
ASR_PROVIDER=browser
ASR_API_KEY=
TTS_PROVIDER=browser
TTS_API_KEY=

# Machine Learning Configuration
ISL_MODEL_PATH=ml/models/isl_bilstm_model.keras
ISL_LABELS_PATH=ml/models/isl_labels.json
ISL_CONFIG_PATH=ml/models/isl_config.json
CONFIDENCE_THRESHOLD=0.75
SEQUENCE_LENGTH=30
